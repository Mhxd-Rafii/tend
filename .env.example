# Server-only variables. Run npm run setup to configure .env.local privately.
# Never use VITE_ prefixes for these values.
TURSO_DATABASE_URL=libsql://YOUR_DATABASE.turso.io
TURSO_AUTH_TOKEN=YOUR_NEW_DATABASE_TOKEN
SESSION_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Local development only. Vercel derives its URL from deployment environment variables.
APP_URL=http://localhost:5173
# Optional password-reset email delivery (verified sender required).
RESEND_API_KEY=
EMAIL_FROM=
