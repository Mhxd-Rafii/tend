{
  "name": "dynamic-habit",
  "private": true,
  "version": "2.0.0",
  "engines": { "node": "22.x" },
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "vercel:login": "vercel login",
    "github:login": "node scripts/github.mjs login",
    "github:status": "node scripts/github.mjs status",
    "github:push": "node scripts/github.mjs publish",
    "deploy": "node scripts/deploy.mjs",
    "launch": "node scripts/launch.mjs",
    "dev": "concurrently -k -n api,web \"tsx watch server/dev.ts\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/dev.ts",
    "build": "npm run typecheck && vite build",
    "test": "vitest run && vitest run --config vitest.server.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check": "tsx scripts/db-check.ts",
    "verify:api": "tsx scripts/verify-api.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "lint": "oxlint",
    "preview": "concurrently -k -n api,web \"tsx server/dev.ts --origin=http://localhost:4173\" \"vite preview\""
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@hookform/resolvers": "^6.0.1",
    "@libsql/client": "^0.18.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-table": "^9.3.1",
    "better-auth": "^1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "idb": "^8.0.4",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^28.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.9",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "oxlint": "^1.89.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vercel": "^65.5.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
